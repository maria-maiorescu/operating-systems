{
    "tasks": [
        {
            "type": "cppbuild",
            "label": "C/C++: gcc build active file",
            "command": "gcc",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "${file}",
                "-o",
                "${fileDirname}/${fileBasenameNoExtension}"
            ],
            "options": {
                "cwd": "${fileDirname}",
                "env": {
                    "PATH": "/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin:${env:PATH}",
                    "SDKROOT": "/Library/Developer/CommandLineTools/SDKs/MacOSX26.5.sdk"
                }
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Task generated by Debugger."
        },
        {
            "type": "shell",
            "label": "Build filesizes_recursive",
            "command": "gcc",
            "args": [
                "-g",
                "-Wall",
                "-Wextra",
                "-std=c11",
                "${workspaceFolder}/lab2/filesizes_recursive.c",
                "-o",
                "${workspaceFolder}/lab2/filesizes_recursive"
            ],
            "options": {
                "cwd": "${workspaceFolder}/lab2"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": "build"
        },
        {
            "type": "shell",
            "label": "Debug filesizes_recursive (default: UVT2)",
            "command": "lldb",
            "args": [
                "--",
                "${workspaceFolder}/lab2/filesizes_recursive",
                "/Users/maria/Documents/UVT2"
            ],
            "options": {
                "cwd": "${workspaceFolder}/lab2"
            },
            "dependsOn": "Build filesizes_recursive",
            "problemMatcher": []
        }
    ],
    "version": "2.0.0"
}